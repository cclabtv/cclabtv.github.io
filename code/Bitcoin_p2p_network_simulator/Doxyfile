#---------------------------------------------------------------------------
# Doxygen configuration for the Bitcoin P2P network simulator.
#
#   doxygen Doxyfile          -> docs/html/index.html
#
# Only settings that differ from the Doxygen defaults are listed. Run
# `doxygen -x Doxyfile` to see this file compared against the defaults, or
# `doxygen -u Doxyfile` to upgrade it after a Doxygen version bump.
#---------------------------------------------------------------------------

#--- Project ---------------------------------------------------------------
PROJECT_NAME           = "Bitcoin P2P Network Simulator"
PROJECT_BRIEF          = "Discrete-event simulation of Bitcoin Core's peer-discovery layer"
PROJECT_NUMBER         =
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#--- Input -----------------------------------------------------------------
INPUT                  = include src
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE                = test Data_Extractor
EXCLUDE_PATTERNS       = */build/* */.git/* *.o
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include

# Treat the project README as the landing page if one is added later.
# USE_MDFILE_AS_MAINPAGE = README.md

#--- What to extract -------------------------------------------------------
# The scheduler's interesting state is private, so private members are
# documented. EXTRACT_ALL keeps undocumented declarations visible while
# coverage is still partial, and WARN_IF_UNDOCUMENTED tracks what is missing.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO

#--- Comment interpretation ------------------------------------------------
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
TAB_SIZE               = 2
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = NO

#--- Layout ----------------------------------------------------------------
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
FULL_PATH_NAMES        = YES

#--- Warnings --------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-warnings.log

#--- Source browser --------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

#--- Output formats --------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#--- Preprocessor ----------------------------------------------------------
# Macro expansion is off: nothing in this project hides declarations behind
# macros, so the parser sees the real signatures as written.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include

#--- Diagrams --------------------------------------------------------------
# Requires graphviz. Call graphs are the useful ones here, since the round
# loop's control flow is the thing a newcomer needs to follow. They are also
# the slowest part of a build; set CALL_GRAPH to NO for a quick pass.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = YES
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 3
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES
